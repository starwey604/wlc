@STORAGE@void @NAME@_clear(@TYPE@_t *value) {
  if (value != NULL) {
    memset(value, 0, sizeof(*value));
  }
}

/* PACKED_ENCODE_BEGIN */
@STORAGE@size_t @NAME@_encoded_size(const @TYPE@_t *value) {
  if (value == NULL) {
    return SIZE_MAX;
  }
@OPTIONAL_MEASURE@  return @WIRE_BYTES@U;
}

@STORAGE@wl_codec_status_t @NAME@_encode(const @TYPE@_t *value, uint8_t *out, size_t out_capacity, size_t *out_length) {
  if (value == NULL) {
    return WL_CODEC_ERR_INVALID_VALUE;
  }
@OPTIONAL_ENCODE@  if (out_length == NULL || out == NULL) {
    return WL_CODEC_ERR_INVALID_VALUE;
  }
  if (out_capacity < @WIRE_BYTES@U) {
    return WL_CODEC_ERR_CAPACITY;
  }
  static const uint8_t prefix[@PREFIX_BYTES@] = {@PREFIX_INIT@};
  memcpy(out, prefix, sizeof(prefix));
  uint8_t *cursor = out + sizeof(prefix);
  for (size_t i = 0U; i < @COUNT@U; ++i) {
    @UINT_TYPE@ bits = 0U;
    memcpy(&bits, &value->@FIELD@[i], sizeof(bits));
    @PUT_LE@(cursor, bits);
    cursor += @ELEM_BYTES@U;
  }
  *out_length = @WIRE_BYTES@U;
  return WL_CODEC_OK;
}
/* PACKED_ENCODE_END */

/* PACKED_DECODE_BEGIN */
@STORAGE@wl_codec_status_t @NAME@_decode(const uint8_t *input, size_t input_length, @TYPE@_t *out) {
  if (out == NULL || (input_length != 0U && input == NULL)) {
    return WL_CODEC_ERR_INVALID_VALUE;
  }
  if (input_length == @WIRE_BYTES@U) {
    static const uint8_t prefix[@PREFIX_BYTES@] = {@PREFIX_INIT@};
    if (memcmp(input, prefix, sizeof(prefix)) == 0) {
      const uint8_t *cursor = input + sizeof(prefix);
@OPTIONAL_PRESENCE@      for (size_t i = 0U; i < @COUNT@U; ++i) {
        @UINT_TYPE@ bits = @GET_LE@(cursor);
        memcpy(&out->@FIELD@[i], &bits, sizeof(bits));
        cursor += @ELEM_BYTES@U;
      }
      return WL_CODEC_OK;
    }
  }
  @TYPE@_t scratch;
  return wl_codec_decode(&@NAME@_desc, input, input_length, out, &scratch);
}
/* PACKED_DECODE_END */
