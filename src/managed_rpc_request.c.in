    case @REQ_ID@: {
      wl_rpc_request_identity_t identity = {.request_fingerprint = @M@_rpc_fingerprint_seed};
      wl_rpc_server_request_t server_request;
      @M@_@S@_request_token_t token;
      size_t canonical_length = 0U;
      uint64_t session = 0U;
      if (!@M@_rpc_request_prepare(event, runtime, @REQ_EVENT@, &result, &session)) break;
      if (runtime->@S@.request_scratch == NULL) {
        result.domain = @P@_RUNTIME_MISSING_SCRATCH;
        break;
      }
      result.detail.rpc.codec_status = @REQ@_decode(event->payload + 20U,
          event->payload_len - 20U, runtime->@S@.request_scratch);
      if (result.detail.rpc.codec_status != WL_CODEC_OK) {
        result.domain = @P@_RUNTIME_CODEC_ERROR;
        break;
      }
      result.detail.rpc.codec_status = @REQ@_wlc_detail_fingerprint(runtime->@S@.request_scratch,
          &identity.request_fingerprint, &canonical_length);
      if (result.detail.rpc.codec_status != WL_CODEC_OK) {
        result.domain = @P@_RUNTIME_CODEC_ERROR;
        break;
      }
      identity.operation_id = result.detail.rpc.operation_id;
      identity.request_message_id = @REQ_ID@;
      identity.response_message_id = @RES_ID@;
      identity.peer_session_id = session;
      if (!@M@_rpc_request_begin(ctx, runtime, &identity, canonical_length, now_ms, &result)) break;
      server_request = result.detail.rpc.server_request;
      memset(&token, 0, sizeof(token));
      token.private_state.owner = runtime;
      token.private_state.incarnation = runtime->rpc_incarnation;
      token.private_state.request = server_request;
#if @REQ_P@_HAS_VALUE && @RES_P@_HAS_VALUE
      if (runtime->@S@.value_handler != NULL) {
        int32_t status;
        @M@_runtime_result_t completed;
        if (runtime->@S@.request_value == NULL || runtime->@S@.response_value == NULL) {
          (void)wl_rpc_server_abandon(runtime->rpc_server, &server_request);
          result.domain = @P@_RUNTIME_MISSING_SCRATCH;
          break;
        }
        /* The view was decoded and has not crossed an application callback. */
        @REQ@_wlc_detail_value_copy(
            runtime->@S@.request_scratch, runtime->@S@.request_value);
        @RES@_value_clear(runtime->@S@.response_value);
        status = runtime->@S@.value_handler(runtime->@S@.value_user_data,
            runtime->@S@.request_value, runtime->@S@.response_value);
        completed = status == 0
            ? @M@_@S@_server_complete_value(runtime, &token, runtime->@S@.response_value, now_ms)
            : @M@_@S@_server_reject(runtime, &token, status, now_ms);
        result.domain = completed.domain;
        result.detail.rpc = completed.detail.rpc;
        if (!@M@_runtime_result_ok(&completed))
          (void)wl_rpc_server_abandon(runtime->rpc_server, &server_request);
        break;
      }
#endif
      if (runtime->@S@.request_handler == NULL) {
        result.detail.rpc.rpc_result = wl_rpc_server_abandon(runtime->rpc_server, &server_request);
        result.domain = @P@_RUNTIME_MISSING_ROUTE;
        break;
      }
      result.detail.rpc.application_result = runtime->@S@.request_handler(
          runtime->@S@.user_data, runtime->@S@.request_scratch, &token, @REQ_DELIVERY@);
      if (result.detail.rpc.application_result != 0) {
        result.detail.rpc.rpc_result = wl_rpc_server_abandon(runtime->rpc_server, &server_request);
        result.domain = @P@_RUNTIME_APPLICATION_ERROR;
      } else result.domain = @P@_RUNTIME_OK;
      break;
    }
