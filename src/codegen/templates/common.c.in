@CODEC_INCLUDE@

#include <limits.h>
#include <stddef.h>
#include <string.h>

enum {
  @K@OPTIONAL,
  @K@REPEATED,
  @K@PACKED,
  @K@BOOL,
  @K@U8,
  @K@U16,
  @K@U32,
  @K@U64,
  @K@I8,
  @K@I16,
  @K@I32,
  @K@I64,
  @K@F32,
  @K@F64,
  @K@FLOAT32,
  @K@FLOAT64,
  @K@BYTES,
  @K@STRING,
  @K@ENUM,
  @K@MESSAGE
};
typedef struct @C@desc @C@desc_t;
typedef struct {
  uint16_t number;
  uint8_t card, kind, required, wire, key_size;
  size_t value, has, count, capacity, element, packed_count;
  uint16_t max_length;
  uint8_t key[3];
  int64_t signed_default;
  uint64_t unsigned_default;
  const char *string_default;
  const @C@desc_t *nested;
} @C@field_t;
enum { @K@LOOKUP_LINEAR, @K@LOOKUP_DENSE, @K@LOOKUP_BINARY };
struct @C@desc { const @C@field_t *fields; size_t count; uint8_t lookup; };

static inline wl_codec_status_t @C@add(size_t *a, size_t b) {
  if (b > SIZE_MAX - *a) return WL_CODEC_ERR_OVERFLOW;
  *a += b;
  return WL_CODEC_OK;
}
static inline size_t @C@vsize(uint64_t v) {
  size_t n = 1U;
  while (v >= 128U) { v >>= 7U; ++n; }
  return n;
}
// WLC_IF VARINT LENGTH PACKED
static inline void @C@putv(uint8_t **p, uint64_t v) {
  while (v >= 128U) { *(*p)++ = (uint8_t)(v | 128U); v >>= 7U; }
  *(*p)++ = (uint8_t)v;
}
// WLC_END
static wl_codec_status_t @C@getv(const uint8_t *in, size_t length, size_t *at,
                                  uint64_t *out) {
  size_t start = *at, n = 0U;
  uint64_t v = 0U;
  while (*at < length && n < 10U) {
    uint8_t b = in[(*at)++];
    if (n == 9U && b > 1U) return WL_CODEC_ERR_OVERFLOW;
    v |= (uint64_t)(b & 127U) << (7U * n++);
    if ((b & 128U) == 0U) {
      if (@C@vsize(v) != *at - start) return WL_CODEC_ERR_MALFORMED;
      *out = v;
      return WL_CODEC_OK;
    }
  }
  return *at == length ? WL_CODEC_ERR_MALFORMED : WL_CODEC_ERR_OVERFLOW;
}
// WLC_IF U32
static inline size_t @C@vsize32(uint32_t value) {
  size_t size = 1U;
  while (value >= 128U) { value >>= 7U; ++size; }
  return size;
}
static inline void @C@putv32(uint8_t **cursor, uint32_t value) {
  while (value >= 128U) {
    *(*cursor)++ = (uint8_t)(value | 128U);
    value >>= 7U;
  }
  *(*cursor)++ = (uint8_t)value;
}
// WLC_IF DIRECT_U32
static wl_codec_status_t @C@getv32(const uint8_t *input, size_t length,
                                          size_t *at, uint32_t *out) {
  /* The 64-bit reader defines status precedence for overwide/noncanonical
   * inputs. Keep that cold path; canonical uint32 needs only five bytes. */
  size_t start = *at;
  uint32_t value = 0U;
  for (unsigned i = 0U; i != 5U && *at != length; ++i) {
    uint8_t byte = input[(*at)++];
    if (i == 4U && byte > 15U) break;
    value |= (uint32_t)(byte & 127U) << (7U * i);
    if ((byte & 128U) == 0U) {
      if (i != 0U && byte == 0U) return WL_CODEC_ERR_MALFORMED;
      *out = value;
      return WL_CODEC_OK;
    }
  }
  *at = start;
  uint64_t wide;
  wl_codec_status_t status = @C@getv(input, length, at, &wide);
  if (status != WL_CODEC_OK) return status;
  if (wide > UINT32_MAX) return WL_CODEC_ERR_OVERFLOW;
  *out = (uint32_t)wide;
  return WL_CODEC_OK;
}
// WLC_END
// WLC_END
// WLC_IF STRING
static bool @C@utf8(const uint8_t *s, size_t n) {
  size_t i = 0U;
  while (i < n) {
    uint8_t a = s[i++];
    if (a < 0x80U) continue;
    size_t need;
    uint32_t v;
    if (a >= 0xC2U && a <= 0xDFU) { need = 1U; v = a & 0x1FU; }
    else if (a >= 0xE0U && a <= 0xEFU) { need = 2U; v = a & 0x0FU; }
    else if (a >= 0xF0U && a <= 0xF4U) { need = 3U; v = a & 0x07U; }
    else return false;
    if (need > n - i) return false;
    while (need-- != 0U) {
      uint8_t b = s[i++];
      if ((b & 0xC0U) != 0x80U) return false;
      v = (v << 6U) | (b & 0x3FU);
    }
    if ((a == 0xE0U && v < 0x800U) ||
        (a == 0xEDU && v >= 0xD800U) ||
        (a == 0xF0U && v < 0x10000U) ||
        (a == 0xF4U && v > 0x10FFFFU)) return false;
  }
  return true;
}
// WLC_END
static inline uint8_t @C@wire(const @C@field_t *f) {
  return f->wire;
}
// WLC_IF I8 I16 I32 ENUM
static inline uint64_t @C@z32(int32_t v) {
  return ((uint32_t)v << 1U) ^ (uint32_t)-(uint32_t)(v < 0);
}
// WLC_END
// WLC_IF I64
static inline uint64_t @C@z64(int64_t v) {
  return ((uint64_t)v << 1U) ^ (uint64_t)-(uint64_t)(v < 0);
}
// WLC_END
// WLC_IF I8 I16 I32 ENUM
static inline int32_t @C@uz32(uint32_t v) {
  return (int32_t)((v >> 1U) ^ (uint32_t)-(v & 1U));
}
// WLC_END
// WLC_IF I64
static inline int64_t @C@uz64(uint64_t v) {
  return (int64_t)((v >> 1U) ^ (uint64_t)-(v & 1U));
}
// WLC_END
static inline wl_codec_status_t @C@measure(const @C@desc_t *, const void *, size_t *);
static wl_codec_status_t @C@measure_impl(const @C@desc_t *, const void *, size_t *, bool);
static void @C@clear(const @C@desc_t *, void *);
static inline wl_codec_status_t @C@decode(const @C@desc_t *, const uint8_t *, size_t,
                                    void *);
static wl_codec_status_t @C@emit_fields(const @C@desc_t *, const void *,
                                         uint8_t **);

// WLC_IF PACKED
static wl_codec_status_t @C@packed_bytes(const @C@field_t *f, size_t *bytes) {
  if (f->packed_count != 0U && f->element > SIZE_MAX / f->packed_count)
    return WL_CODEC_ERR_OVERFLOW;
  *bytes = f->element * f->packed_count;
  return WL_CODEC_OK;
}
// WLC_END
static wl_codec_status_t @C@body(const @C@field_t *f, const void *p,
                                  size_t *n, bool validated) {
  (void)p;
  (void)validated;
  *n = 0U;
  switch (f->kind) {
// WLC_IF BOOL
    case @K@BOOL: {
      bool v = *(const bool *)p;
      if (v != false && v != true) return WL_CODEC_ERR_INVALID_VALUE;
      *n = 1U;
      return WL_CODEC_OK;
    }
// WLC_END
// WLC_IF U8
    case @K@U8: *n = @C@vsize(*(const uint8_t *)p); return WL_CODEC_OK;
// WLC_END
// WLC_IF U16
    case @K@U16: *n = @C@vsize(*(const uint16_t *)p); return WL_CODEC_OK;
// WLC_END
// WLC_IF U32
    case @K@U32: *n = @C@vsize(*(const uint32_t *)p); return WL_CODEC_OK;
// WLC_END
// WLC_IF U64
    case @K@U64: *n = @C@vsize(*(const uint64_t *)p); return WL_CODEC_OK;
// WLC_END
// WLC_IF I8
    case @K@I8: *n = @C@vsize(@C@z32(*(const int8_t *)p)); return WL_CODEC_OK;
// WLC_END
// WLC_IF I16
    case @K@I16: *n = @C@vsize(@C@z32(*(const int16_t *)p)); return WL_CODEC_OK;
// WLC_END
// WLC_IF I32 ENUM
// WLC_IF I32
    case @K@I32:
// WLC_END
// WLC_IF ENUM
    case @K@ENUM:
// WLC_END
      *n = @C@vsize(@C@z32(*(const int32_t *)p)); return WL_CODEC_OK;
// WLC_END
// WLC_IF I64
    case @K@I64: *n = @C@vsize(@C@z64(*(const int64_t *)p)); return WL_CODEC_OK;
// WLC_END
// WLC_IF F32 FLOAT32
// WLC_IF F32
    case @K@F32:
// WLC_END
// WLC_IF FLOAT32
    case @K@FLOAT32:
// WLC_END
      *n = 4U; return WL_CODEC_OK;
// WLC_END
// WLC_IF F64 FLOAT64
// WLC_IF F64
    case @K@F64:
// WLC_END
// WLC_IF FLOAT64
    case @K@FLOAT64:
// WLC_END
      *n = 8U; return WL_CODEC_OK;
// WLC_END
// WLC_IF BYTES
    case @K@BYTES: {
      const wl_codec_bytes_t *v = p;
      if (f->max_length != 0U && v->length > (size_t)f->max_length)
        return WL_CODEC_ERR_INVALID_VALUE;
      if (v->length != 0U && v->data == NULL) return WL_CODEC_ERR_INVALID_VALUE;
      if (@C@add(n, @C@vsize(v->length)) != WL_CODEC_OK)
        return WL_CODEC_ERR_OVERFLOW;
      return @C@add(n, v->length);
    }
// WLC_END
// WLC_IF STRING
    case @K@STRING: {
      const wl_codec_string_t *v = p;
      if (f->max_length != 0U && v->length > (size_t)f->max_length)
        return WL_CODEC_ERR_INVALID_VALUE;
      if (v->length != 0U && v->data == NULL) return WL_CODEC_ERR_INVALID_VALUE;
      if (!validated && !@C@utf8((const uint8_t *)v->data, v->length)) return WL_CODEC_ERR_UTF8;
      if (@C@add(n, @C@vsize(v->length)) != WL_CODEC_OK)
        return WL_CODEC_ERR_OVERFLOW;
      return @C@add(n, v->length);
    }
// WLC_END
// WLC_IF MESSAGE
    case @K@MESSAGE: {
      size_t child;
      wl_codec_status_t s = @C@measure_impl(f->nested, p, &child, validated);
      if (s != WL_CODEC_OK) return s;
      *n = @C@vsize(child);
      return @C@add(n, child);
    }
// WLC_END
    default: return WL_CODEC_ERR_INVALID_VALUE;
  }
}
static wl_codec_status_t @C@measure_impl(const @C@desc_t *d, const void *value,
                                     size_t *out, bool validated) {
  size_t n = 0U;
  if (d == NULL || value == NULL || out == NULL) return WL_CODEC_ERR_INVALID_VALUE;
  for (size_t i = 0U; i < d->count; ++i) {
    const @C@field_t *f = &d->fields[i];
    const uint8_t *base = value;
// WLC_IF PACKED
    if (f->card == @K@PACKED) {
      size_t bytes;
      wl_codec_status_t s;
      if (!*(const bool *)(base + f->has)) {
        if (f->required != 0U) return WL_CODEC_ERR_MISSING_REQUIRED_FIELD;
        continue;
      }
      if ((s = @C@packed_bytes(f, &bytes)) != WL_CODEC_OK) return s;
      if ((s = @C@add(&n, f->key_size)) != WL_CODEC_OK ||
          (s = @C@add(&n, @C@vsize(bytes))) != WL_CODEC_OK ||
          (s = @C@add(&n, bytes)) != WL_CODEC_OK) return s;
      continue;
    }
// WLC_END
    size_t count = 1U;
    if (f->card == @K@OPTIONAL) {
      if (!*(const bool *)(base + f->has)) {
        if (f->required != 0U) return WL_CODEC_ERR_MISSING_REQUIRED_FIELD;
        continue;
      }
    } else {
      count = *(const size_t *)(base + f->count);
      if ((count != 0U && *(void *const *)(base + f->value) == NULL) ||
          count > *(const size_t *)(base + f->capacity))
        return WL_CODEC_ERR_INVALID_VALUE;
    }
    for (size_t j = 0U; j < count; ++j) {
      size_t body;
      const void *p = f->card == @K@REPEATED
                          ? *(const uint8_t *const *)(base + f->value) + j * f->element
                          : base + f->value;
      wl_codec_status_t s = @C@body(f, p, &body, validated);
      if (s != WL_CODEC_OK) return s;
      if ((s = @C@add(&n, f->key_size)) != WL_CODEC_OK ||
          (s = @C@add(&n, body)) != WL_CODEC_OK) return s;
    }
  }
  *out = n;
  return WL_CODEC_OK;
}
static inline wl_codec_status_t @C@measure(const @C@desc_t *d, const void *value, size_t *out) {
  return @C@measure_impl(d, value, out, false);
}
// WLC_IF MESSAGE
// WLC_IF FINGERPRINT
static wl_codec_status_t @C@measure_validated(const @C@desc_t *d, const void *value, size_t *out) {
  return @C@measure_impl(d, value, out, true);
}
// WLC_END
// WLC_END
static void @C@clear(const @C@desc_t *d, void *value) {
  uint8_t *base = value;
  for (size_t i = 0U; i < d->count; ++i) {
    const @C@field_t *f = &d->fields[i];
    void *p = base + f->value;
    (void)p;
    if (f->card == @K@REPEATED) {
      *(size_t *)(base + f->count) = 0U;
      continue;
    }
    *(bool *)(base + f->has) = false;
// WLC_IF PACKED
    if (f->card == @K@PACKED) {
      memset(p, 0, f->element * f->packed_count);
      continue;
    }
// WLC_END
    switch (f->kind) {
// WLC_IF MESSAGE
    case @K@MESSAGE: @C@clear(f->nested, p); break;
// WLC_END
// WLC_IF STRING
    case @K@STRING:
      *(wl_codec_string_t *)p = (wl_codec_string_t){f->string_default, (size_t)f->unsigned_default}; break;
// WLC_END
// WLC_IF BYTES
    case @K@BYTES: *(wl_codec_bytes_t *)p = (wl_codec_bytes_t){NULL, 0U}; break;
// WLC_END
// WLC_IF FLOAT32 FLOAT64
// WLC_IF FLOAT32
    case @K@FLOAT32:
// WLC_END
// WLC_IF FLOAT64
    case @K@FLOAT64:
// WLC_END
      memset(p, 0, f->element); break;
// WLC_END
// WLC_IF BOOL
    case @K@BOOL: *(bool *)p = f->unsigned_default != 0U; break;
// WLC_END
// WLC_IF I8
    case @K@I8: *(int8_t *)p = (int8_t)f->signed_default; break;
// WLC_END
// WLC_IF I16
    case @K@I16: *(int16_t *)p = (int16_t)f->signed_default; break;
// WLC_END
// WLC_IF I32 ENUM
// WLC_IF I32
    case @K@I32:
// WLC_END
// WLC_IF ENUM
    case @K@ENUM:
// WLC_END
      *(int32_t *)p = (int32_t)f->signed_default; break;
// WLC_END
// WLC_IF I64
    case @K@I64: *(int64_t *)p = f->signed_default; break;
// WLC_END
// WLC_IF U8
    case @K@U8: *(uint8_t *)p = (uint8_t)f->unsigned_default; break;
// WLC_END
// WLC_IF U16
    case @K@U16: *(uint16_t *)p = (uint16_t)f->unsigned_default; break;
// WLC_END
// WLC_IF U32 F32
// WLC_IF U32
    case @K@U32:
// WLC_END
// WLC_IF F32
    case @K@F32:
// WLC_END
      *(uint32_t *)p = (uint32_t)f->unsigned_default; break;
// WLC_END
// WLC_IF U64 F64
// WLC_IF U64
    case @K@U64:
// WLC_END
// WLC_IF F64
    case @K@F64:
// WLC_END
      *(uint64_t *)p = f->unsigned_default; break;
// WLC_END
    default: break;
    }
  }
}
// WLC_IF FIXED
static inline void @C@put32(uint8_t **p, uint32_t v) {
  *(*p)++ = (uint8_t)(v >> 24U);
  *(*p)++ = (uint8_t)(v >> 16U);
  *(*p)++ = (uint8_t)(v >> 8U);
  *(*p)++ = (uint8_t)v;
}
// WLC_END
// WLC_IF F64 FLOAT64
static inline void @C@put64(uint8_t **p, uint64_t v) {
  @C@put32(p, (uint32_t)(v >> 32U));
  @C@put32(p, (uint32_t)v);
}
// WLC_END
// WLC_IF BYTES STRING
static inline void @C@copy_span(uint8_t **out, const void *data, size_t length) {
  if (length != 0U) { memcpy(*out, data, length); *out += length; }
}
// WLC_END
static inline void @C@put_key(uint8_t **out, const @C@field_t *f) {
  *(*out)++ = f->key[0];
  if (f->key_size > 1U) {
    *(*out)++ = f->key[1];
    if (f->key_size > 2U) *(*out)++ = f->key[2];
  }
}
