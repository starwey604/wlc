
static inline wl_codec_status_t @C@encode(const @C@desc_t *d, const void *value,
                                    uint8_t *out, size_t cap, size_t *length) {
  size_t n;
  wl_codec_status_t s = @C@measure(d, value, &n);
  if (s != WL_CODEC_OK || length == NULL || (n != 0U && out == NULL))
    return s == WL_CODEC_OK ? WL_CODEC_ERR_INVALID_VALUE : s;
  if (cap < n) return WL_CODEC_ERR_CAPACITY;
  uint8_t *p = out;
  if ((s = @C@emit_fields(d, value, &p)) != WL_CODEC_OK) return s;
  *length = n;
  return WL_CODEC_OK;
}
static wl_codec_status_t @C@skip(uint8_t wire, const uint8_t *in, size_t n,
                                  size_t *at) {
  uint64_t length;
  wl_codec_status_t s;
  if (wire == 0U) return @C@getv(in, n, at, &length);
  if (wire == 1U) {
    if (n - *at < 8U) return WL_CODEC_ERR_MALFORMED;
    *at += 8U;
    return WL_CODEC_OK;
  }
  if (wire == 5U) {
    if (n - *at < 4U) return WL_CODEC_ERR_MALFORMED;
    *at += 4U;
    return WL_CODEC_OK;
  }
  if (wire != 2U) return WL_CODEC_ERR_MALFORMED;
  if ((s = @C@getv(in, n, at, &length)) != WL_CODEC_OK) return s;
  if (length > n - *at) return WL_CODEC_ERR_MALFORMED;
  *at += (size_t)length;
  return WL_CODEC_OK;
}
// WLC_IF FIXED
static wl_codec_status_t @C@read_fixed(uint8_t kind, const uint8_t *in,
                                        size_t n, size_t *at, void *out) {
  size_t bytes = (kind == @K@F32 || kind == @K@FLOAT32) ? 4U : 8U;
  if (n - *at < bytes) return WL_CODEC_ERR_MALFORMED;
  uint64_t bits = 0U;
  for (size_t i = 0U; i < bytes; ++i) bits = (bits << 8U) | in[(*at)++];
  switch (kind) {
// WLC_IF F32
    case @K@F32: *(uint32_t *)out = (uint32_t)bits; break;
// WLC_END
// WLC_IF F64
    case @K@F64: *(uint64_t *)out = bits; break;
// WLC_END
// WLC_IF FLOAT32
    case @K@FLOAT32: {
      uint32_t bits32 = (uint32_t)bits;
      memcpy(out, &bits32, sizeof(bits32)); break;
    }
// WLC_END
// WLC_IF FLOAT64
    case @K@FLOAT64: memcpy(out, &bits, sizeof(bits)); break;
// WLC_END
    default: return WL_CODEC_ERR_INVALID_VALUE;
  }
  return WL_CODEC_OK;
}
// WLC_END
static wl_codec_status_t @C@read_value(const @C@field_t *f, const uint8_t *in,
                                        size_t n, size_t *at, void *out) {
  (void)in; (void)n; (void)at; (void)out;
  switch (f->kind) {
// WLC_IF F32 F64 FLOAT32 FLOAT64
// WLC_IF F32
    case @K@F32:
// WLC_END
// WLC_IF F64
    case @K@F64:
// WLC_END
// WLC_IF FLOAT32
    case @K@FLOAT32:
// WLC_END
// WLC_IF FLOAT64
    case @K@FLOAT64:
// WLC_END
      return @C@read_fixed(f->kind, in, n, at, out);
// WLC_END
// WLC_IF BYTES STRING MESSAGE
// WLC_IF BYTES
    case @K@BYTES:
// WLC_END
// WLC_IF STRING
    case @K@STRING:
// WLC_END
// WLC_IF MESSAGE
    case @K@MESSAGE:
// WLC_END
      {
      uint64_t v;
      wl_codec_status_t s = @C@getv(in, n, at, &v);
      if (s != WL_CODEC_OK) return s;
      if ((f->kind == @K@BYTES || f->kind == @K@STRING) &&
          f->max_length != 0U && v > (uint64_t)f->max_length)
        return WL_CODEC_ERR_INVALID_VALUE;
      if (v > n - *at) return WL_CODEC_ERR_MALFORMED;
      size_t bytes = (size_t)v;
// WLC_IF BYTES
      if (f->kind == @K@BYTES)
        *(wl_codec_bytes_t *)out = (wl_codec_bytes_t){in + *at, bytes};
// WLC_END
// WLC_IF STRING
      if (f->kind == @K@STRING) {
        if (!@C@utf8(in + *at, bytes)) return WL_CODEC_ERR_UTF8;
        *(wl_codec_string_t *)out = (wl_codec_string_t){(const char *)(in + *at), bytes};
      }
// WLC_END
// WLC_IF MESSAGE
      if (f->kind == @K@MESSAGE) {
        s = @C@decode(f->nested, in + *at, bytes, out);
        if (s != WL_CODEC_OK) return s;
      }
// WLC_END
      *at += bytes;
      return WL_CODEC_OK;
    }
// WLC_END
    default: break;
  }
// WLC_IF VARINT
  uint64_t v;
  wl_codec_status_t s = @C@getv(in, n, at, &v);
  if (s != WL_CODEC_OK) return s;
  switch (f->kind) {
// WLC_IF BOOL
    case @K@BOOL:
      if (v > 1U) return WL_CODEC_ERR_INVALID_VALUE;
      *(bool *)out = v != 0U; break;
// WLC_END
// WLC_IF U8
    case @K@U8:
      if (v > UINT8_MAX) return WL_CODEC_ERR_OVERFLOW;
      *(uint8_t *)out = (uint8_t)v; break;
// WLC_END
// WLC_IF U16
    case @K@U16:
      if (v > UINT16_MAX) return WL_CODEC_ERR_OVERFLOW;
      *(uint16_t *)out = (uint16_t)v; break;
// WLC_END
// WLC_IF U32
    case @K@U32:
      if (v > UINT32_MAX) return WL_CODEC_ERR_OVERFLOW;
      *(uint32_t *)out = (uint32_t)v; break;
// WLC_END
// WLC_IF U64
    case @K@U64: *(uint64_t *)out = v; break;
// WLC_END
// WLC_IF I8
    case @K@I8:
      if (v > UINT8_MAX) return WL_CODEC_ERR_OVERFLOW;
      *(int8_t *)out = (int8_t)@C@uz32((uint32_t)v); break;
// WLC_END
// WLC_IF I16
    case @K@I16:
      if (v > UINT16_MAX) return WL_CODEC_ERR_OVERFLOW;
      *(int16_t *)out = (int16_t)@C@uz32((uint32_t)v); break;
// WLC_END
// WLC_IF I32 ENUM
// WLC_IF I32
    case @K@I32:
// WLC_END
// WLC_IF ENUM
    case @K@ENUM:
// WLC_END

      if (v > UINT32_MAX) return WL_CODEC_ERR_OVERFLOW;
      *(int32_t *)out = @C@uz32((uint32_t)v); break;
// WLC_END
// WLC_IF I64
    case @K@I64: *(int64_t *)out = @C@uz64(v); break;
// WLC_END
    default: return WL_CODEC_ERR_INVALID_VALUE;
  }
  return WL_CODEC_OK;
// WLC_END
  return WL_CODEC_ERR_INVALID_VALUE;
}
// WLC_IF PACKED
static wl_codec_status_t @C@read_packed(const @C@field_t *f,
                                         const uint8_t *in, size_t n,
                                         size_t *at, void *out) {
  uint64_t encoded_bytes;
  size_t expected_bytes;
  wl_codec_status_t s;
  if ((s = @C@getv(in, n, at, &encoded_bytes)) != WL_CODEC_OK) return s;
  if ((s = @C@packed_bytes(f, &expected_bytes)) != WL_CODEC_OK) return s;
  if (encoded_bytes != expected_bytes || expected_bytes > n - *at)
    return WL_CODEC_ERR_MALFORMED;
// WLC_IF F32 FLOAT32
  if (f->kind == @K@F32 || f->kind == @K@FLOAT32) {
    for (size_t j = 0U; j < f->packed_count; ++j) {
      uint32_t bits = ((uint32_t)in[*at] << 24U) |
                      ((uint32_t)in[*at + 1U] << 16U) |
                      ((uint32_t)in[*at + 2U] << 8U) |
                      (uint32_t)in[*at + 3U];
      memcpy((uint8_t *)out + j * f->element, &bits, sizeof(bits));
      *at += 4U;
    }
    return WL_CODEC_OK;
  }
// WLC_END
// WLC_IF F64 FLOAT64
  if (f->kind == @K@F64 || f->kind == @K@FLOAT64) {
    for (size_t j = 0U; j < f->packed_count; ++j) {
      uint64_t bits = 0U;
      for (size_t i = 0U; i < 8U; ++i) bits = (bits << 8U) | in[(*at)++];
      memcpy((uint8_t *)out + j * f->element, &bits, sizeof(bits));
    }
    return WL_CODEC_OK;
  }
// WLC_END
  return WL_CODEC_ERR_INVALID_VALUE;
}
// WLC_END
static const @C@field_t *@C@find_field(const @C@desc_t *d, uint16_t number) {
  if (d->lookup == @K@LOOKUP_DENSE) {
    size_t index = (size_t)number - (size_t)d->fields[0].number;
    return index < d->count ? &d->fields[index] : NULL;
  }
  if (d->lookup == @K@LOOKUP_BINARY) {
    size_t lo = 0U, hi = d->count;
    while (lo < hi) {
      size_t mid = lo + (hi - lo) / 2U;
      uint16_t candidate = d->fields[mid].number;
      if (candidate == number) return &d->fields[mid];
      if (candidate < number) lo = mid + 1U;
      else hi = mid;
    }
    return NULL;
  }
  for (size_t i = 0U; i < d->count; ++i)
    if (d->fields[i].number == number) return &d->fields[i];
  return NULL;
}
