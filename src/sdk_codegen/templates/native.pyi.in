from typing import Any

core_version: str
codegen_contract: str
binding_api: int

class Error:
    kind: str
    outcome: int
    status: int
    os_error: int
    os_message: str

def connect(peer_address: str, peer_port: int, bind_address: str, bind_port: int) -> tuple[Client | None, Error | None]: ...

class Client:
    def close(self) -> None: ...
    @property
    def is_open(self) -> bool: ...
    @property
    def local_port(self) -> int: ...
