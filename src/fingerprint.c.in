/* Generator-private canonical sink. Only successful decode results enter here.
 * The shared emitter orders known fields, drops unknowns, and preserves presence.
 * Scalar bytes use the ordinary endian/varint writers; no raw-frame hashing. */
typedef struct {
  uint64_t hash;
  size_t length;
  wl_codec_status_t status;
} @C@hash_state_t;
static inline wl_codec_status_t @C@hash_emit_fields(const @C@desc_t *, const void *, @C@hash_state_t *);
static void @C@hash_copy_span(@C@hash_state_t *out, const void *data, size_t length) {
  const uint8_t *bytes = data;
  if (out->status != WL_CODEC_OK) return;
  out->status = @C@add(&out->length, length);
  if (out->status != WL_CODEC_OK) return;
  uint64_t hash = out->hash;
  for (size_t i = 0U; i < length; ++i)
    hash = (hash ^ bytes[i]) * UINT64_C(0x100000001b3);
  out->hash = hash;
}
// WLC_IF VARINT LENGTH PACKED
static inline void @C@hash_putv(@C@hash_state_t *out, uint64_t value) {
  uint8_t bytes[10], *cursor = bytes;
  @C@putv(&cursor, value);
  @C@hash_copy_span(out, bytes, (size_t)(cursor - bytes));
}
// WLC_END
// WLC_IF U32
static inline void @C@hash_putv32(@C@hash_state_t *out, uint32_t value) {
  uint8_t bytes[5], *cursor = bytes;
  @C@putv32(&cursor, value);
  @C@hash_copy_span(out, bytes, (size_t)(cursor - bytes));
}
// WLC_END
static inline void @C@hash_put_key(@C@hash_state_t *out, const @C@field_t *f) {
  @C@hash_copy_span(out, f->key, f->key_size);
}
// WLC_IF F32 FLOAT32
static inline void @C@hash_put32(@C@hash_state_t *out, uint32_t value) {
  uint8_t bytes[4], *cursor = bytes;
  @C@put32(&cursor, value);
  @C@hash_copy_span(out, bytes, sizeof(bytes));
}
// WLC_END
// WLC_IF F64 FLOAT64
static inline void @C@hash_put64(@C@hash_state_t *out, uint64_t value) {
  uint8_t bytes[8], *cursor = bytes;
  @C@put64(&cursor, value);
  @C@hash_copy_span(out, bytes, sizeof(bytes));
}
// WLC_END
